<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="E_commerce.SiteMaster" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>E-commerce - <%: Page.Title %></title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>

    <webopt:bundlereference runat="server" path="~/Content/css" />
    <link rel="shortcut icon" href="images/logos/LogoDark.png" type="image/x-icon">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="styles/shared/shared.css">
    <link rel="stylesheet" href="styles/shared/header.css">
    <link rel="stylesheet" href="styles/shared/footer.css">

    <link rel="stylesheet" href="styles/style.css">
    <link rel="stylesheet" href="styles/products.css">
    <link rel="stylesheet" href="styles/product.css">
    <link rel="stylesheet" href="styles/orders.css">
    <link rel="stylesheet" href="styles/checkout.css">
</head>
<body>
    <form runat="server">
        <asp:ScriptManager runat="server">
            <Scripts>
                <%--To learn more about bundling scripts in ScriptManager see https://go.microsoft.com/fwlink/?LinkID=301884 --%>
                <%--Framework Scripts--%>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
                <%--Site Scripts--%>
            </Scripts>
        </asp:ScriptManager>

        <nav class="navbar navbar-expand-sm navbar-toggleable-sm">
            <div class="container">
                <img src="images/logos/LogoLight.png" alt="Brand Logo" height="30" class="d-inline-block align-text-top">
                <a class="navbar-brand brand-name" runat="server" href="~/">E-COMMERCE</a>
                <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Toggle navigation" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item d-flex mx-auto search-bar w-auto">
                            <asp:TextBox ID="txtSearch" runat="server" CssClass="form-control me-2 search-input" placeholder="Search..."></asp:TextBox>
                            <asp:Button ID="btnSearch" runat="server" Text="🔎" CssClass="btn btn-outline-primary" OnClick="btnSearch_Click" />
                        </li>

                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Products">Products</a></li>
                        
                        <li class="nav-item">
                            <asp:HyperLink ID="lnkContact" runat="server" NavigateUrl="~/Contact" Text="Contact" Visible="false" CssClass="nav-link" />
                        </li>

                        <li class="nav-item">
                            <asp:HyperLink ID="lnkOrders" runat="server" NavigateUrl="~/Orders" Text="Orders" Visible="false" CssClass="nav-link" />
                        </li>

                        <li class="nav-item">
                            <asp:HyperLink ID="lnkCart" runat="server" NavigateUrl="~/Cart" Text="Cart🛒" Visible="false" CssClass="nav-link" />
                        </li>

                        <li class="nav-item">
                            <asp:HyperLink ID="lnkAddProduct" runat="server" NavigateUrl="~/AddProduct" Text="Add Product" Visible="false" CssClass="nav-link" />
                        </li>

                        <li class="nav-item">
                            <asp:HyperLink ID="lnkPosted" runat="server" NavigateUrl="~/Posted" Text="Posted" Visible="false" CssClass="nav-link" />
                        </li>

                        <li class="nav-item">
                            <asp:HyperLink ID="lnkAdmin" runat="server" NavigateUrl="~/Dashboard" Text="Dashboard" Visible="false" CssClass="nav-link" />
                        </li>

                        <li class="nav-item">
                            <asp:HyperLink ID="lnkLogin" runat="server" NavigateUrl="~/Login" Text="Login" CssClass="nav-link" Visible="true" />
                        </li>

                        <li class="nav-item">
                            <asp:Button ID="btnLogout" runat="server" Text="Log Out" CssClass="btn nav-link" Visible="false" OnClick="btnLogout_Click" />
                        </li>

                        <li class="nav-item">
                            <a class="nav-link biggerText" runat="server" href="EditProfile.aspx"><i class="bi bi-person-circle blue-text"></i></a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
        <div class="container body-content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
            
            <hr />

            <footer>
                <div class="container-fluid text-center">
                    <div class="row first-row">
                        <div class="footer-content col-lg-4">
                            <h3>Contact Us</h3>
                            <p>
                                <a href="mailto:albionaleka@protonmail.com"><i class="bi bi-envelope"></i>: e-commerce@gmail.com</a>
                            </p>
                            
                            <p><i class="bi bi-telephone"></i>: +38344123123</p>
                            <p><i class="bi bi-geo-alt-fill"></i>: Kosovo</p>

                            <p>
                                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1504723.9799341739!2d19.582632763617266!3d42.557118477399534!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x13537af354bf7df1%3A0xbfffeedfabc31791!2sKosovo!5e0!3m2!1sen!2s!4v1738709326409!5m2!1sen!2s" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" class="img-fluid w-100 rounded"></iframe>
                            </p>
                        </div>

                        <div class="footer-content col-lg-4">
                            <h3>Quick Links</h3>
                            <p><a href="Default.aspx">Home</a></p>
                            <p><a href="Products.aspx">Products</a></p>
                            <p><a href="Contact.aspx">Contact</a></p>
                        </div>

                        <div class="footer-content col-lg-4">
                            <h3>Follow Us</h3>
                            <p><a href="https://www.facebook.com" target="_blank"><i class="bi bi-facebook"></i>: Facebook</a></p>
                            <p><a href="https://www.instagram.com" target="_blank"><i class="bi bi-instagram"></i>: Instagram</a></p>
                            <p><a href="https://www.x.com" target="_blank"><i class="bi bi-twitter"></i>: Twitter</a></p>
                        </div>
                    </div>

                    <div class="row">
                        <div class="bottom-bar col align-middle">
                            <span>&copy; <%: DateTime.Now.Year %> - E-commerce</span>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </form>
    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/Scripts/bootstrap.js") %>
    </asp:PlaceHolder>
</body>
</html>
